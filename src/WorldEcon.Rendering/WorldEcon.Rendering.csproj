<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WorldEcon.Rendering</RootNamespace>
    <!-- MapRenderer writes cell spans straight into a raster canvas's pixels (TriangleSpans). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WorldEcon.Rendering.Tests.Unit" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <ProjectReference Include="..\WorldEcon.WorldGen\WorldEcon.WorldGen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared GLSL bodies for every GPU backend (desktop OpenGL, WebGL2); see Gpu/GpuShaders.cs. -->
    <EmbeddedResource Include="Gpu\Shaders\*.glsl" />
  </ItemGroup>
</Project>
