<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorldEcon.Gui.ViewModels"
             x:Class="WorldEcon.Gui.Views.TimeBar"
             x:DataType="vm:TimeControlsViewModel">
  <!-- Date │ Play/Pause + speed │ +1h … +1y │ To: year month day time Go │ during a jump: progress and Stop. -->
  <Border Padding="8,4" Background="#131722" BorderBrush="#2A3040" BorderThickness="0,0,0,1"
          IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding UnavailableReason}">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Name="TimeDate" Text="{Binding DateText}" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="230" />
      <Separator Width="1" Background="#2A3040" />
      <Button Name="TimePlay" Content="{Binding PlayButtonText}" Click="OnPlay" MinWidth="64" IsEnabled="{Binding ShowsJumpControls}" />
      <ComboBox Name="TimeSpeed" ItemsSource="{Binding SpeedNames}" SelectedIndex="{Binding SpeedIndex}" MinWidth="96" />
      <Separator Width="1" Background="#2A3040" />
      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowsJumpControls}">
        <Button Name="Jump1h" Content="+1h" Tag="1h" Click="OnJump" IsEnabled="{Binding CanJump}" />
        <Button Name="Jump1d" Content="+1d" Tag="1d" Click="OnJump" IsEnabled="{Binding CanJump}" />
        <Button Name="Jump1w" Content="+1w" Tag="1w" Click="OnJump" IsEnabled="{Binding CanJump}" />
        <Button Name="Jump1M" Content="+1M" Tag="1M" Click="OnJump" IsEnabled="{Binding CanJump}" />
        <Button Name="Jump1y" Content="+1y" Tag="1y" Click="OnJump" IsEnabled="{Binding CanJump}" />
        <Separator Width="1" Background="#2A3040" Margin="6,0" />
        <TextBlock Text="To:" VerticalAlignment="Center" />
        <NumericUpDown Name="ToYear" Value="{Binding ToYear}" Increment="1" FormatString="0" MinWidth="110" ToolTip.Tip="Year" />
        <ComboBox Name="ToMonth" ItemsSource="{Binding MonthNames}" SelectedIndex="{Binding ToMonthIndex}" MinWidth="100" />
        <NumericUpDown Name="ToDay" Value="{Binding ToDay}" Minimum="1" Maximum="{Binding MonthLength}" Increment="1" FormatString="0" MinWidth="90"
                       ToolTip.Tip="Day" />
        <TextBox Name="ToTime" Text="{Binding ToTime}" Width="60" MaxLength="5" PlaceholderText="hh:mm" ToolTip.Tip="Time of day, hh:mm" />
        <Button Name="ToGo" Content="Go" Click="OnGo" IsEnabled="{Binding CanGo}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsJumping}">
        <TextBlock Name="TimeProgress" Text="{Binding ProgressText}" VerticalAlignment="Center" />
        <Button Name="TimeStop" Content="Stop" Click="OnStop" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
